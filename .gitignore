# ============================================================
# Brandora AI — .gitignore
# Node.js + Python + Next.js + FastAPI Monorepo
# ============================================================

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
out/
dist/
build/

# Turbopack
.turbo/

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.env.venv/
virtualenv/

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.coveragerc
nosetests.xml
pytest.xml
test-results/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Linting
.ruff_cache/

# Celery
celerybeat-schedule
celerybeat.pid

# ── Environment Files ─────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production
# DO NOT ignore .env.example — it is committed intentionally

# ── Docker ───────────────────────────────────────────────────
# Local Docker volumes data
postgres_data/
redis_data/

# ── Railway ──────────────────────────────────────────────────
.railway/

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ─────────────────────────────────────────────
# JetBrains
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code — keep settings.json and extensions.json
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Vim
*.swp
*.swo
*~

# Emacs
*#
.#*

# ── Logs ─────────────────────────────────────────────────────
*.log
*.log.*
logs/
log/

# ── Misc ─────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel/
.netlify/
storybook-static/

# Alembic env (local only)
backend/alembic/env.py.local

# Uploaded files / media
uploads/
media/
