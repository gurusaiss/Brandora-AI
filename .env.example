# ============================================================
# BRANDORA AI — SINGLE ROOT ENVIRONMENT FILE
# ============================================================
# This is the ONE .env file for the entire monorepo.
# Backend, frontend, and all Docker services read from here.
#
# Setup:
#   cp .env.example .env        ← from project root
#   make setup                  ← alternative
#
# How each layer reads it:
#   Backend  — pydantic-settings walks up to find this file
#   Frontend — `npm run dev` uses dotenv-cli: `dotenv -e ../.env`
#   Docker   — docker-compose env_file: ./.env injects all vars
#
# NEVER commit .env — it is in .gitignore.
# This file (.env.example) IS committed and kept up to date.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Async PostgreSQL connection string (used by SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brandora_ai

# Supabase project credentials (can replace self-hosted Postgres in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Redis ─────────────────────────────────────────────────────
# Redis URL for Celery broker and caching
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────
# JWT secret key — minimum 32 characters, change in production
SECRET_KEY=your-super-secret-key-minimum-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers ──────────────────────────────────────────────
# OpenAI (GPT-4o for content generation)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_AI_API_KEY=AIza...

# Default AI provider: openai | anthropic | google
DEFAULT_AI_PROVIDER=openai

# ── Social Platform OAuth ─────────────────────────────────────
# LinkedIn OAuth2 App
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Meta / Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback

# Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Facebook Pages
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── App Configuration ─────────────────────────────────────────
# Environment: development | staging | testing | production
ENVIRONMENT=development

# CORS — allowed origins (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Frontend (Next.js public variables) ──────────────────────
# These are browser-visible; do NOT put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Brandora AI

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Monitoring & Observability ────────────────────────────────
# Sentry error tracking (leave blank to disable)
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Email (optional for MVP — emails are logged if not configured) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@brandoraai.com
FROM_NAME=Brandora AI

# ── Flower (Celery monitoring UI) ─────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_in_production

# ── Storage (for future file uploads) ─────────────────────────
# AWS S3 (or Supabase Storage for MVP)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=brandora-ai-uploads

# Supabase Storage (alternative to S3 for MVP)
SUPABASE_STORAGE_BUCKET=brandora-assets

# ── Rate Limiting ─────────────────────────────────────────────
# Requests per minute for API endpoints
API_RATE_LIMIT_PER_MINUTE=60
AI_GENERATION_RATE_LIMIT_PER_HOUR=20

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_SOCIAL_POSTING=false
ENABLE_ANALYTICS=true
ENABLE_SCHEDULING=true
ENABLE_MULTI_LANGUAGE=false
